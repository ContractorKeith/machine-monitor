# Written by `machine-monitor service install`; remove with `machine-monitor service uninstall`.
[Unit]
Description=machine-monitor agent

[Service]
ExecStart="/opt/machine monitor/machine-monitor" "agent" "--hub" "http://192.168.1.10:7777"
Environment="MACHINE_MONITOR_DIR=/srv/mm $HOME 100%% \"q\""
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
