<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.contractorkeith.machine-monitor.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/machine monitor/machine-monitor</string>
		<string>agent</string>
		<string>--hub</string>
		<string>http://192.168.1.10:7777</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MACHINE_MONITOR_DIR</key>
		<string>/tmp/a&amp;b</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/alice/Library/Application Support/machine-monitor/logs/agent.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alice/Library/Application Support/machine-monitor/logs/agent.log</string>
</dict>
</plist>
