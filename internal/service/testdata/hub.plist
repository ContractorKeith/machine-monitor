<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.contractorkeith.machine-monitor.hub</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/machine-monitor</string>
		<string>hub</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/alice/Library/Application Support/machine-monitor/logs/hub.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/alice/Library/Application Support/machine-monitor/logs/hub.log</string>
</dict>
</plist>
